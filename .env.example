# Copy to .env and fill in what you use. Everything is optional:
# with nothing set, the engine runs fully offline (mock brain + babble voice).

# --- Brain (Claude) -----------------------------------------------------------
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. Change it here if you want a different model.
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. Live chat wants "low" for snappy replies.
CLAUDE_EFFORT_LIVE=low
CLAUDE_EFFORT_SCRIPTS=medium
# Hard stop for API spend per engine run (estimated from token usage). 0 = no cap.
DAILY_BUDGET_USD=10

# --- Character ----------------------------------------------------------------
CHARACTER_FILE=characters/crumb.yaml

# --- Voice (TTS) --------------------------------------------------------------
# babble (offline gibberish, default) | elevenlabs | openai | none
TTS_PROVIDER=babble
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Any OpenAI-compatible /audio/speech endpoint: OpenAI, or a local Kokoro-FastAPI
# server (free) at http://localhost:8880/v1 with OPENAI_TTS_MODEL=kokoro.
OPENAI_TTS_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Chat sources -------------------------------------------------------------
# Twitch: read-only, no login needed. Just the channel name.
TWITCH_CHANNEL=
# YouTube: the video ID of your live stream plus an API key (or OAuth token).
YOUTUBE_LIVE_VIDEO_ID=
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_TOKEN=
# Minimum seconds between YouTube polls (each poll costs API quota).
YOUTUBE_MIN_POLL_SECONDS=8

# --- Server -------------------------------------------------------------------
PORT=4870
HOST=127.0.0.1
# Require you to approve every reply in the console before it is spoken.
REVIEW_MODE=false

# --- Shorts studio ------------------------------------------------------------
# Override if ffmpeg / Chromium are not on PATH.
FFMPEG_PATH=
CHROMIUM_PATH=
