{
  "name": "ai-vtuber-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A live, chat-driven AI VTuber: Claude-powered persona, safety rails, voice, browser avatar for OBS, and a Shorts renderer that turns live moments into vertical videos.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "demo": "tsx src/index.ts --demo",
    "short": "tsx src/cli/short.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/*.test.ts\"",
    "test:e2e": "node --import tsx --test --test-reporter=spec \"test/e2e/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "obscenity": "^0.4.6",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.2"
  }
}
